# Local/server secrets. Copy to .env for local development; never commit .env.
# Runtime JSON/TTL state is persisted in the `site_state` Docker volume; there
# is no standalone Redis service in Personal-Site anymore.

# Telegram MTProto worker (repo Telegram-Worker-Userbot, systemd unit
# tg-worker, port 4100). Both /jobs and /hiring go through it whenever it is
# set and never fall back to t.me/s — production has no direct Telegram egress,
# so an unset or unreachable value empties the Telegram part of both boards.
TELEGRAM_WORKER_URL=

# Durable CV/candidate storage: the shared flat-finder Postgres, in its own
# schema (tables are created on first use). This is the durable candidate source
# of truth; the local state volume is only the hot runtime snapshot/TTL layer.
HIRING_DATABASE_URL=postgres://flatfinder:PASSWORD@flat-finder-postgres:5432/flatfinder
HIRING_DB_SCHEMA=hiring

# Durable vacancy/CV crawl queue. By default the queue reuses
# HIRING_DATABASE_URL; set a separate URL only when you intentionally want its
# task tables in another Postgres database.
JOBS_QUEUE_DATABASE_URL=
JOBS_QUEUE_DB_SCHEMA=site_queue
JOBS_QUEUE_REFRESH_SECONDS=1800
JOBS_QUEUE_MAX_ATTEMPTS=5
JOBS_QUEUE_LEASE_SECONDS=240
JOBS_QUEUE_RETRY_BASE_MS=30000
JOBS_QUEUE_RETRY_MAX_MS=300000
JOBS_QUEUE_DISPATCH_TICK_SECONDS=10
JOBS_QUEUE_POLL_SECONDS=1
# How often every CV source is scheduled (seconds), and the kill switch for
# candidate crawling. Queue priority/retry/leases are stored in Postgres.
HIRING_QUEUE_REFRESH_SECONDS=1800
# While a source has not reached the three-month cutoff, continue its bounded
# historical walk more often. The dispatcher skips this sweep while candidate
# work is already pending/running, so it cannot grow an unbounded duplicate queue.
HIRING_QUEUE_BACKFILL_SECONDS=300
HIRING_QUEUE_ENABLED=on
# Public logged-out CV/resume boards. No recruiter-only contacts are bypassed;
# if a board hides a phone/email, the original profile URL is kept as the
# platform contact. Activity is strictly limited to the latest 3 months.
HIRING_WEB_CV_SOURCE=on
# Optional comma-separated whitelist. Empty = all verified built-in adapters.
# Available built-ins: flagma-uz,careerist-uz,rabotakz,talent-ua,flagma-ro
HIRING_WEB_CV_SOURCES=
HIRING_WEB_CV_MAX_PAGES=5
# Historical listing pages read per source and queue cycle. Progress is stored,
# so the three-month window fills without one long request.
HIRING_WEB_CV_BACKFILL_PAGES=4
# ish-bor.uz needs detail-page date verification, so it is isolated from the
# generic list-page adapters. Unknown/undated CVs are deliberately rejected.
HIRING_ISHBOR_CV_SOURCE=on
HIRING_ISHBOR_MAX_PAGES=3
HIRING_ISHBOR_BACKFILL_PAGES=1
# Anonymous public rows from UzJobs' resume index. Names and direct contacts
# hidden by the source are never bypassed or inferred. The directory mixes old
# and recently-active profiles between pages, so backfill walks it in larger
# bounded batches instead of stopping on a page with zero recent visits.
HIRING_UZJOBS_CV_SOURCE=on
HIRING_UZJOBS_BACKFILL_PAGES=40
# Public Facebook groups/pages and logged-out Threads Recent search. Empty
# HIRING_SOCIAL_SOURCES enables the built-in targets; set a comma-separated
# source-key whitelist to isolate noisy/blocked sources without redeploying.
# The flat-finder backend proxy is reachable over ai-net. QUEUE_INTERNAL_KEY in
# this deployment must match the key used by flat-finder's internal social route.
HIRING_SOCIAL_SOURCE=on
HIRING_SOCIAL_SOURCES=
HIRING_SOCIAL_API_URL=http://flat-finder-backend:4000/internal/social/fetch

# Private shared AI enrichment worker (server runtime only). In production the
# Docker service resolves over the external ai-net network.
AI_WORKER_URL=http://ai-worker:4030
AI_WORKER_KEY=
AI_WORKER_VACANCY_BATCH=10
AI_WORKER_MAX_PENDING=60
AI_WORKER_SUBMIT_CONCURRENCY=4
# Control-plane calls only: job submission/result polling. LLM generation itself
# is asynchronous inside ai-worker and has its own inference timeout.
AI_WORKER_REQUEST_TIMEOUT_MS=10000
AI_WORKER_PROXY_RETRIES=1
AI_WORKER_POLL_MS=5000

# Job Finder sources
JOOBLE_KEY=
# Each location consumes one Jooble API request per refresh.
JOOBLE_LOCATIONS=Uzbekistan,Kazakhstan,Kyrgyzstan,Tajikistan,Turkmenistan,Ukraine
DEVKG_SOURCE=on
ISHGO_SOURCE=on
ITJOBS_UZ_SOURCE=on
# Regional public boards + direct employers added to the `companies` fan-out:
# Ishkop, ish-bor, IshPlus, MUK, Tegen, Microsoft, Ubisoft, EA, EPAM and others.
SOURCE_EXPANSION_JOBS=on
# Official airline/airport career sources: Air Astana/FlyArystan, Uzbekistan
# airlines from source expansion, Bucharest Airports, Cluj Airport, TAROM,
# Wizz Air and Ryanair. Failed sites are isolated and never fail other sources.
AVIATION_JOBS_SOURCE=on
# LinkedIn public guest job search. Base countries run every cycle; major
# UZ/KZ/RO cities and every Ukrainian oblast are rotated in bounded batches.
# Each location is paginated with start=0,25,50... and remote/USA-relocation
# searches run as separate high-priority passes.
LINKEDIN_SOURCE=on
LINKEDIN_LOCATIONS=
LINKEDIN_MAX_PAGES=4
LINKEDIN_REGIONAL_LOCATIONS_PER_CYCLE=10
LINKEDIN_PRIORITY_QUERIES_PER_CYCLE=4
LINKEDIN_LOCATION_CONCURRENCY=4
LINKEDIN_REQUEST_TIMEOUT_MS=10000
LINKEDIN_SOURCE_TIMEOUT_MS=150000
# Facebook/Threads vacancy searches. Threads covers major cities and all
# Ukrainian oblasts by rotation, plus worldwide remote and USA relocation/visa
# searches every cycle. Facebook remains limited to verified public groups.
SOCIAL_JOB_SOURCE=on
THREADS_JOB_REGIONAL_QUERIES_PER_CYCLE=8
THREADS_JOB_PRIORITY_QUERIES_PER_CYCLE=4
THREADS_JOB_REQUEST_TIMEOUT_MS=150000
FACEBOOK_JOB_REQUEST_TIMEOUT_MS=90000
SOCIAL_JOB_SOURCE_TIMEOUT_MS=150000
# Public candidate-facing boards collected from community/profile resources,
# including USA visa-sponsorship-focused boards.
PUBLIC_JOB_BOARDS_SOURCE=on
# Chrome TLS/JA3 impersonation fallback for public job sites that reject plain
# Node fetch with 403/429 or fail before returning an HTTP response. The
# sidecar is internal-only and has its own allowlist/cooldown; normal APIs/RSS
# continue to use native fetch directly.
JOB_BROWSER_FETCHER_URL=http://job-browser-fetcher:4040
JOB_BROWSER_IMPERSONATE=chrome124
JOB_BROWSER_TIMEOUT=25
JOB_BROWSER_ATTEMPTS=2
JOB_BROWSER_RETRY_BACKOFF=2
JOB_BROWSER_PROXY_TIMEOUT_MS=65000
JOB_BROWSER_429_COOLDOWN=900
JOB_BROWSER_403_COOLDOWN=900
# Extra comma-separated domains beyond the built-ins. Keep empty normally.
JOB_BROWSER_ALLOWED_HOSTS=
# Delayed public H-1B sponsor feed from NotifyYouInc/2026-H1B-Sponsor-Jobs.
# The source is treated as sponsor-history evidence, not a guarantee that every
# specific vacancy will sponsor. Optional token raises GitHub API rate limits.
USA_VISA_SPONSOR_SOURCE=on
USA_VISA_GITHUB_TOKEN=
USA_VISA_GITHUB_MAX_JOBS=80
USA_VISA_GITHUB_RECENT_COMMITS=2
# Public Telegram previews; no bot token or Telegram account is required.
TELEGRAM_SOURCE=on
# Enables duplicate mirrors and narrow feeds (disabled by default).
TELEGRAM_INCLUDE_LOW_PRIORITY=off
# OLX UZ/KZ currently returns 403 from some deployment IPs; verify before enabling.
OLX_SOURCE=off

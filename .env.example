# Personal Site server configuration. Backend domain workers, crawlers and
# migrations are configured in whiteslove.me-backend-platform instead.

# Backend Platform read APIs used by the site's same-origin BFF routes.
VACANCIES_API_URL=http://vacancies-api:4010
CV_API_URL=http://cv-api:4011

# Canonical apartment backend: flats-api on whiteslove-backend-platform.
# Replace the retired flat-finder-backend hostname in existing overrides;
# set this explicitly for another host.
FLAT_API_URL=http://flats-api:4000

# Private AI enrichment worker used by translation proxy routes.
AI_WORKER_URL=http://ai-worker:4030
AI_WORKER_KEY=
AI_WORKER_REQUEST_TIMEOUT_MS=10000
AI_WORKER_PROXY_RETRIES=1
AI_WORKER_POLL_MS=5000

# Website ↔ Telegram subscription handoff/status contract. The bot runtime and
# delivery loop live in backend-platform; the site only needs its public name
# and access to the dedicated subscriptions schema.
TELEGRAM_SUBSCRIPTION_BOT_ENABLED=off
TELEGRAM_SUBSCRIPTION_BOT_USERNAME=
SUBSCRIPTIONS_DATABASE_URL=
SUBSCRIPTIONS_DB_SCHEMA=subscriptions
SITE_PUBLIC_URL=https://whiteslove.me

# Persistent state and readiness behavior for the Nuxt container.
SITE_STATE_DIR=/var/app/state/site
READINESS_API_TIMEOUT_MS=2000

# Legal pages (/privacy, /terms, /cookies, /legal, /data-rights). Read at
# request time by /legal-identity; nothing is hardcoded. While any value is
# missing the pages say they require operator review. The operator is a
# natural person, so no company registration fields exist. Use the same
# values as the backend platform's .env.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
LEGAL_OPERATOR_TYPE=natural_person
LEGAL_GOVERNING_LAW=

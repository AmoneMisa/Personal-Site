# Personal Site server configuration. Backend domain workers, crawlers and
# migrations are configured in whiteslove.me-backend-platform instead.

# Backend Platform read APIs used by the site's same-origin BFF routes.
VACANCIES_API_URL=http://vacancies-api:4010
CV_API_URL=http://cv-api:4011

# Canonical apartment backend: flats-api on whiteslove-backend-platform.
# Replace the retired flat-finder-backend hostname in existing overrides;
# set this explicitly for another host.
FLAT_API_URL=http://flats-api:4000

# Private AI enrichment worker used by translation proxy routes.
AI_WORKER_URL=http://ai-worker:4030
AI_WORKER_KEY=
AI_WORKER_REQUEST_TIMEOUT_MS=10000
AI_WORKER_PROXY_RETRIES=1
AI_WORKER_POLL_MS=5000

# Website ↔ Telegram subscription handoff/status contract. The bot runtime and
# delivery loop live in backend-platform; the site only needs its public name
# and access to the dedicated subscriptions schema.
TELEGRAM_SUBSCRIPTION_BOT_ENABLED=off
TELEGRAM_SUBSCRIPTION_BOT_USERNAME=
SUBSCRIPTIONS_DATABASE_URL=
SUBSCRIPTIONS_DB_SCHEMA=subscriptions
SITE_PUBLIC_URL=https://whiteslove.me

# Persistent state and readiness behavior for the Nuxt container.
SITE_STATE_DIR=/var/app/state/site
READINESS_API_TIMEOUT_MS=2000

# Legal pages (/privacy, /terms, /cookies, /legal, /data-rights). Read at
# request time by /legal-identity; nothing is hardcoded. While any value is
# missing the pages say they require operator review. The operator is a
# natural person, so no company registration fields exist. Use the same
# values as the backend platform's .env.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
LEGAL_OPERATOR_TYPE=natural_person
LEGAL_GOVERNING_LAW=

# Sign in with Google for saved flats (Flat Finder favourites tab). Use the
# OAuth "Web application" client; its authorised redirect URI must be
# ${SITE_PUBLIC_URL}/flats-account-google-callback. The same client id must be
# listed in the backend platform's GOOGLE_OAUTH_CLIENT_IDS. Either value empty
# = the sign-in button is hidden.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Observability. /metrics is the Prometheus scrape endpoint for this Nuxt
# process (request latency per matched route, upstream fetch latency/errors per
# configured service above, real-user Web Vitals from /rum, Node process
# stats). It is reachable through the public edge, so it returns 404 until
# METRICS_KEY is set and then requires "Authorization: Bearer <METRICS_KEY>".
METRICS_KEY=
# Prometheus (compose profile "monitoring") scrapes /metrics with METRICS_KEY;
# deploy.sh starts it only when METRICS_KEY is set. Its UI is bound to
# 127.0.0.1:PROMETHEUS_PORT on the server (SSH tunnel). Scrape config lives in
# monitoring/prometheus.yml.
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d
# Telegram reports through the subscription bot (TELEGRAM_SUBSCRIPTION_BOT_TOKEN):
# Alertmanager sends Prometheus alerts (monitoring/alerts.yml) when they start
# and resolve, and metrics-digest sends a daily summary (monitoring/digest.mjs)
# at METRICS_DIGEST_HOUR_UTC. Both start only when TELEGRAM_METRICS_CHAT_ID is
# set: the operator's chat with the bot (press Start in the bot first).
TELEGRAM_METRICS_CHAT_ID=
METRICS_DIGEST_HOUR_UTC=5

# Cookieless visitor analytics and product events (self-hosted Umami, compose
# profile "analytics"). deploy.sh starts the umami service only when
# UMAMI_DATABASE_URL is set; it must point at a dedicated database (create it
# in the shared Postgres first). Browsers load the tracker and send events only
# through the site's /stats/* proxy, so UMAMI_URL stays internal. The dashboard
# is bound to 127.0.0.1:UMAMI_DASHBOARD_PORT (default 3101) on the server;
# reach it with an SSH tunnel. After
# adding the site in the dashboard, put its website id in
# NUXT_PUBLIC_UMAMI_WEBSITE_ID; empty = no tracker is injected.
UMAMI_URL=http://umami:3000
UMAMI_DATABASE_URL=
UMAMI_APP_SECRET=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

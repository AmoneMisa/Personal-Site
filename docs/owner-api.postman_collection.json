{
  "info": {
    "name": "WhitesLove — Owner API",
    "description": "Owner-only content editing for whiteslove.me. Set the collection variables `baseUrl` and `ownerKey` (Collection > Variables). Writes accept either the `X-Owner-Key` header or an admin Bearer token.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://whiteslove.me/api" },
    { "key": "ownerKey", "value": "REPLACE_WITH_OWNER_API_KEY" },
    { "key": "adminToken", "value": "" }
  ],
  "item": [
    {
      "name": "Auth — admin login (optional)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth", "login"] },
        "body": { "mode": "raw", "raw": "{\n  \"email\": \"you@example.com\",\n  \"password\": \"\",\n  \"remember_me\": true\n}" }
      }
    },
    {
      "name": "Settings — get all (public)",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/settings", "host": ["{{baseUrl}}"], "path": ["settings"] }
      }
    },
    {
      "name": "Settings — upsert (owner)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "X-Owner-Key", "value": "{{ownerKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/settings", "host": ["{{baseUrl}}"], "path": ["settings"] },
        "body": { "mode": "raw", "raw": "{\n  \"seo.ogImage\": \"https://whiteslove.me/images/og-default.png\",\n  \"seo.canonicalBase\": \"https://whiteslove.me\",\n  \"seo.robots\": \"index, follow\",\n  \"seo.social\": { \"github\": \"https://github.com/AmoneMisa\", \"linkedin\": \"https://www.linkedin.com/in/\" }\n}" }
      }
    },
    {
      "name": "Settings — delete key (owner)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "X-Owner-Key", "value": "{{ownerKey}}" }],
        "url": { "raw": "{{baseUrl}}/settings/seo.robots", "host": ["{{baseUrl}}"], "path": ["settings", "seo.robots"] }
      }
    },
    {
      "name": "Translations — apply (owner)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Owner-Key", "value": "{{ownerKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/owner/translations/apply", "host": ["{{baseUrl}}"], "path": ["owner", "translations", "apply"] },
        "body": { "mode": "raw", "raw": "{\n  \"upsert\": [\n    { \"key\": \"hero.title\", \"values\": { \"ru\": \"Маргарита — Frontend-разработчик\", \"en\": \"Margarita — Frontend Developer\" } }\n  ],\n  \"delete\": [ \"pricing.limitedOffer\" ]\n}" }
      }
    },
    {
      "name": "Items — list (owner)",
      "request": {
        "method": "GET",
        "header": [{ "key": "X-Owner-Key", "value": "{{ownerKey}}" }],
        "url": { "raw": "{{baseUrl}}/owner/items/testimonials", "host": ["{{baseUrl}}"], "path": ["owner", "items", "testimonials"] }
      }
    },
    {
      "name": "Items — create (owner)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Owner-Key", "value": "{{ownerKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/owner/items/testimonials", "host": ["{{baseUrl}}"], "path": ["owner", "items", "testimonials"] },
        "body": { "mode": "raw", "raw": "{\n  \"nameKey\": \"t.acme.name\",\n  \"roleKey\": \"t.acme.role\",\n  \"quoteKey\": \"t.acme.quote\",\n  \"rating\": 5,\n  \"order\": 1,\n  \"isVisible\": true\n}" }
      }
    },
    {
      "name": "Items — update (owner)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "X-Owner-Key", "value": "{{ownerKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/owner/items/testimonials/:id", "host": ["{{baseUrl}}"], "path": ["owner", "items", "testimonials", ":id"], "variable": [{ "key": "id", "value": "" }] },
        "body": { "mode": "raw", "raw": "{\n  \"isVisible\": false\n}" }
      }
    },
    {
      "name": "Items — delete (owner)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "X-Owner-Key", "value": "{{ownerKey}}" }],
        "url": { "raw": "{{baseUrl}}/owner/items/testimonials/:id", "host": ["{{baseUrl}}"], "path": ["owner", "items", "testimonials", ":id"], "variable": [{ "key": "id", "value": "" }] }
      }
    },
    {
      "name": "Unified apply (owner)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "X-Owner-Key", "value": "{{ownerKey}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "url": { "raw": "{{baseUrl}}/owner/apply", "host": ["{{baseUrl}}"], "path": ["owner", "apply"] },
        "body": { "mode": "raw", "raw": "{\n  \"translations\": { \"upsert\": [ { \"key\": \"footer.about\", \"values\": { \"ru\": \"…\", \"en\": \"…\" } } ] },\n  \"settings\": { \"seo.ogImage\": \"https://whiteslove.me/images/og-default.png\" },\n  \"headerMenu\": [ { \"type\": \"simple\", \"labelKey\": \"menu.about\", \"href\": \"/cv\" } ]\n}" }
      }
    }
  ]
}
